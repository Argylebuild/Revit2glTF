<Project Sdk="Microsoft.NET.Sdk">

  <!-- ================ core settings ================ -->
  <PropertyGroup>
    <!-- Revit 2025/2026 run on .NET 8 and Revit 2027+ on .NET 10. The target framework follows the
         configuration name, so this one project builds every SDK-style Revit year. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('2027'))">net10.0-windows</TargetFramework>
    <RootNamespace>GLTFRevitExport</RootNamespace>
    <UseWPF>true</UseWPF>              <!-- only needed if XAML is present -->
    <UseWindowsForms>true</UseWindowsForms> <!-- brings System.Drawing.Common for texture re-encoding -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Argyle.glTFRevitExport</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Release2025;Release2026;Release2027;Debug2025;Debug2026;Debug2027</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>


  <!-- ================ 2025 build configuration ================ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2025|x64'">
    <OutputPath>..\build\Release2025\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2025</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug2025|x64'">
    <OutputPath>..\build\Release2025\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2025</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug2026|x64'">
    <OutputPath>..\build\Release2026\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2026</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <!-- ================ 2026 build configuration ================ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2026|x64'">
    <OutputPath>..\build\Release2026\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2026</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- ================ 2027 build configuration (.NET 10) ================ -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug2027|x64'">
    <OutputPath>..\build\Release2027\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2027</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release2027|x64'">
    <OutputPath>..\build\Release2027\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>REVIT;REVIT2027</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('2025'))">
      <RevitVersion>2025</RevitVersion>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('2026'))">
      <RevitVersion>2026</RevitVersion>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('2027'))">
      <RevitVersion>2027</RevitVersion>
    </PropertyGroup>

  <!-- ================ source sharing ================ -->
  <ItemGroup>
    <Compile Include="..\GLTFRevitExport\**\*.cs" Exclude="..\GLTFRevitExport.Net8\**\*.*;&#xD;&#xA;                      ..\GLTFRevitExport\obj\**\*.*;&#xD;&#xA;                      ..\GLTFRevitExport\bin\**\*.*;&#xD;&#xA;                      ..\GLTFRevitExport\**\*.g.cs;&#xD;&#xA;                      ..\GLTFRevitExport\**\*.g.i.cs" />
                      
    <EmbeddedResource Include="..\GLTFRevitExport\**\*.resx" Exclude="..\GLTFRevitExport\obj\**\*.*;&#xD;&#xA;                              ..\GLTFRevitExport\bin\**\*.*" />
                              
    <Page Include="..\GLTFRevitExport\**\*.xaml" Exclude="..\GLTFRevitExport\obj\**\*.*;&#xD;&#xA;                  ..\GLTFRevitExport\bin\**\*.*" />
  </ItemGroup>


  <!-- ================ project references ================ -->
  <ItemGroup>
    <ProjectReference Include="..\lib\glTF2BIM\GLTF2BIM.Net8\GLTF2BIM.Net8.csproj" />
  </ItemGroup>

  <!-- ================ NuGet packages ================ -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion).0.0" />
  </ItemGroup>


</Project>
